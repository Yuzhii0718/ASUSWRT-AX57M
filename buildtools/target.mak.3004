	SW_HW_AUTH=y NATNL_AICLOUD=y NATNL_AIHOME=y \
	SYSSTATE=y NETOOL=y TRACEROUTE=y STAINFO=y \
	ALEXA=y GOOGLE_ASST=y \
	MULTICASTIPTV=y QUAGGA=y DUPVIF=y LACP=y \
	AMAS=y DWB=y ETHOBD=y MSSID_PRELINK=y CFGSYNC_LOCSYNC=y BCN_RPT=n BTM_11V=n \
	REPEATER=y PROXYSTA=y WIFI_DRV_DISABLE=y MUMIMO_5G=y MUMIMO_2G=y OPTIMIZE_XBOX=y ATF=y ACL96=y NEW_USER_LOW_RSSI=y AVBLCHAN=y REDIRECT_DNAME=n WPSMULTIBAND=y MTK_TW_AUTO_BAND4=n MTK_BSD=y \
	ACCEL_PPTPD=y OPENVPN=y VPNC=y IPSEC=STRONGSWAN IPSEC_SRVCLI_ONLY=SRV INSTANT_GUARD=y VPN_FUSION=y WIREGUARD=y \
	UBI=y UBIFS=y DUMP_OOPS_MSG=y \
	PSISTLOG=y UTF8_SSID=y NEWSSID_REV4=y \
	TRX_TAIL_INFO=y RALINK_DFS=y EDCCA_NEW=y \
	ATCOVER=y DUALWAN=y \
	EXTRA_KERNEL_CONFIGS=""

export RT-AX52 := ${RT-AX52AX57M_BASE} BW160M=n BUILD_NAME="RT-AX52"
export RT-AX57M := ${RT-AX52AX57M_BASE} BW160M=n WANRED_LED=y BWDPI=y UUPLUGIN=y BUILD_NAME="RT-AX57M"

