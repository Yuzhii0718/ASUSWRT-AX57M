############################################################################
export RT-AX52AX57M_BASE := MUSL64=y MUSL_LIBC=y IPV6SUPP=y RALINK=y NEW_RGDM=y HTTPS=y SSH=y MT798X=y MT7981=y MT7531=y NVRAM_SIZE=0x20000 NVRAM_ENCRYPT=1 \
	LANWAN_LED=y BTN_WPS_ALLLED=y SW_CTRL_ALLLED=y BLINK_LED=y \
	COBRAND=y LAN50=all ODMPID=y MDNS=y LETSENCRYPT=y GETREALIP=y EBTABLES=y AUTODICT=y TUNEK="n" \
