# MT79xx / MediaTek Filogic platform only
export GENERAL_BASE := LIVE_UPDATE_RSA=3

############################################################################
# MT7981 (Filogic 820) models
############################################################################
export CHEETAH := MUSL64=y MUSL_LIBC=y IPV6SUPP=y RALINK=y NEW_RGDM=y HTTPS=y SSH=y MT798X=y MT7981=y MT7531=y EBTABLES=y AUTODICT=y BUILD_NAME="CHEETAH" NVRAM_SIZE=0x20000 TUNEK="n" \
	PARENTAL2=y EMAIL=y FRS_FEEDBACK=y WIFI_DRV_DISABLE=y ODMPID=y MDNS=y FINDASUS=y TEMPROOTFS=y BW160M=y \
	NVRAM_ENCRYPT=1 REBOOT_SCHEDULE=y OPENVPN=y VPNC=y \
	SAMBA3=3.6.x USBEXTRAS=y USB="USB" HD_SPINDOWN=y XHCI=y NTFS="open" TFAT=n HFS="open" EXT4FS=y DISK_MONITOR=y \
	APP="network" NEW_APP_ARM=y MODEM=y USB_WAN_BACKUP=y PRINTER=y MEDIASRV=y \
	UBI=y UBIFS=y DUMP_OOPS_MSG=y CHEETAH_1GWAN=n \
	TCODE=y MUMIMO_5G=y MUMIMO_2G=y LAN50=all \
	PSISTLOG=y UTF8_SSID=y NEWSSID_REV4=y \
	TRX_TAIL_INFO=y RALINK_DFS=y EDCCA_NEW=y \
	ATCOVER=y DUALWAN=y
export CHEETAH_CFG := $(CHEETAH)

